# The server is intentionally loopback-only by default.
DOTA_ADVISOR_HOST=127.0.0.1
DOTA_ADVISOR_PORT=8000

# Automatic capture/recommendation controls.
DOTA_ADVISOR_CAPTURE_INTERVAL_SECONDS=5
DOTA_ADVISOR_RECOMMENDATION_COOLDOWN_SECONDS=45
DOTA_ADVISOR_CHANGE_THRESHOLD=0.025
DOTA_ADVISOR_CONFIDENCE_THRESHOLD=0.65
DOTA_ADVISOR_MONITOR_INDEX=1

# Screenshot handling. Full screenshots are never persisted by the application.
DOTA_ADVISOR_DEBUG_SAVE_CROPS=false
DOTA_ADVISOR_REGIONS_PATH=config/hud_regions.json
DOTA_ADVISOR_DATABASE_PATH=.data/advisor.db

# Optional Gemini enhancement. Manual mode works without these values.
GEMINI_API_KEY=
DOTA_ADVISOR_GEMINI_MODEL=gemini-2.5-flash
DOTA_ADVISOR_GEMINI_TIMEOUT_SECONDS=30
DOTA_ADVISOR_GEMINI_MAX_CONCURRENCY=1

